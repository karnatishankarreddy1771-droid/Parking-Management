{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user profile with role assignment",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["Resident", "Security", "Admin"] },
        "flatNumber": { "type": "string", "maxLength": 20 },
        "phone": { "type": "string", "maxLength": 20 },
        "profilePhoto": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "name", "email", "role", "createdAt"]
    },
    "ParkingSlot": {
      "title": "ParkingSlot",
      "description": "Physical parking slot definition",
      "type": "object",
      "properties": {
        "slotId": { "type": "string" },
        "slotNumber": { "type": "string", "maxLength": 20 },
        "building": { "type": "string", "maxLength": 50 },
        "floor": { "type": "string", "maxLength": 20 },
        "type": { "type": "string", "enum": ["Resident", "Visitor", "EV Charging", "Accessible"] },
        "assignedResident": { "type": "string" },
        "assignedResidentName": { "type": "string" },
        "status": { "type": "string", "enum": ["Available", "Occupied", "Reserved", "Maintenance"] }
      },
      "required": ["slotId", "slotNumber", "building", "floor", "type", "status"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Vehicle registered by a resident",
      "type": "object",
      "properties": {
        "vehicleId": { "type": "string" },
        "ownerId": { "type": "string" },
        "vehicleNumber": { "type": "string", "maxLength": 20 },
        "vehicleType": { "type": "string", "enum": ["Car", "Bike", "SUV", "EV", "Other"] },
        "make": { "type": "string", "maxLength": 50 },
        "model": { "type": "string", "maxLength": 50 },
        "color": { "type": "string", "maxLength": 30 }
      },
      "required": ["vehicleId", "ownerId", "vehicleNumber", "vehicleType"]
    },
    "VisitorBooking": {
      "title": "VisitorBooking",
      "description": "Pass generated by resident for visitor parking",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string" },
        "residentId": { "type": "string" },
        "residentName": { "type": "string" },
        "flatNumber": { "type": "string" },
        "guestName": { "type": "string", "maxLength": 100 },
        "guestPhone": { "type": "string", "maxLength": 20 },
        "vehicleNumber": { "type": "string", "maxLength": 20 },
        "vehicleType": { "type": "string", "enum": ["Car", "Bike", "SUV", "EV", "Other"] },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "slotId": { "type": "string" },
        "slotNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Checked In", "Checked Out", "Cancelled", "Expired"] },
        "passCode": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["bookingId", "residentId", "guestName", "vehicleNumber", "vehicleType", "date", "startTime", "endTime", "status", "createdAt"]
    },
    "VisitorLog": {
      "title": "VisitorLog",
      "description": "Physical security entry and exit log",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string" },
        "guestName": { "type": "string" },
        "vehicleNumber": { "type": "string" },
        "flatNumber": { "type": "string" },
        "entryTime": { "type": "string" },
        "exitTime": { "type": "string" },
        "securityId": { "type": "string" },
        "securityName": { "type": "string" },
        "status": { "type": "string", "enum": ["Inside", "Exited"] }
      },
      "required": ["bookingId", "entryTime", "securityId", "status"]
    },
    "Violation": {
      "title": "Violation",
      "description": "Reported unauthorized or improper parking incident",
      "type": "object",
      "properties": {
        "residentId": { "type": "string" },
        "slotId": { "type": "string" },
        "slotNumber": { "type": "string" },
        "vehicleNumber": { "type": "string" },
        "description": { "type": "string", "maxLength": 500 },
        "severity": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "status": { "type": "string", "enum": ["Open", "Under Review", "Resolved", "Dismissed"] },
        "createdAt": { "type": "string" },
        "reporterName": { "type": "string" },
        "photoUrl": { "type": "string" }
      },
      "required": ["vehicleNumber", "description", "severity", "status", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification alert",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["Booking", "Security", "Violation", "System"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "message", "type", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User account and role data"
    },
    "/parkingSlots/{slotId}": {
      "schema": { "$ref": "#/entities/ParkingSlot" },
      "description": "Parking slots registry"
    },
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Registered resident vehicles"
    },
    "/visitorBookings/{bookingId}": {
      "schema": { "$ref": "#/entities/VisitorBooking" },
      "description": "Visitor booking passes"
    },
    "/visitorLogs/{logId}": {
      "schema": { "$ref": "#/entities/VisitorLog" },
      "description": "Security entry and exit logs"
    },
    "/violations/{violationId}": {
      "schema": { "$ref": "#/entities/Violation" },
      "description": "Parking violations and disputes"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "System notifications"
    }
  }
}
